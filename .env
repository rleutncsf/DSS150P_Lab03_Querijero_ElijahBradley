# Copy to .env and edit. .env is git-ignored and must never be committed.
# Use a URL-safe password (letters/digits/_-) because Airflow embeds it in a connection URL.
POSTGRES_USER=dss150p
POSTGRES_PASSWORD=DSS150p_Lab_3
POSTGRES_DB=dss150p
# localhost for commands run on your machine; docker-compose overrides this to "postgres" inside containers
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Airflow (Goal 4). On Linux set AIRFLOW_UID to the output of `id -u`; on macOS/Windows keep 50000.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=DSS150p_Lab_3